# Server
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173
# Refresh-cookie Secure flag. Unset = secure in production (needs HTTPS).
# Set "false" for plain-HTTP deploys (e.g. local docker compose).
COOKIE_SECURE=false
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@host/db?sslmode=require
JWT_SECRET_KEY=change-me-to-a-long-random-secret
REDIS_URL=redis://default:password@host:6379
RESEND_KEY=re_xxxxxxxxxxxx
B2_KEY_ID=your-key-id
B2_APPLICATION_KEY=your-application-key
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET=kivo-media
