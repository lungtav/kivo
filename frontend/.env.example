# Leave empty when the frontend and API share an origin (including Vite development proxy).
# VITE_API_URL=https://api.example.com

# Explicit realtime (socket.io) endpoint. Falls back to VITE_API_URL, then to
# the current origin (which the Vite dev proxy forwards to the API).
# VITE_SOCKET_URL=https://api.example.com

# Development-only proxy target.
VITE_API_TARGET=http://localhost:5000
